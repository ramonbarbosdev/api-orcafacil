DB_DATABASE=orcafacil_central
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=disable # disable em dev local; require em producao

JWT_SECRET=change-me-use-at-least-32-characters-long
JWT_EXPIRATION_MINUTES=480

# false em producao para ocultar detalhes tecnicos nos erros 500
API_EXPOSE_ERROR_DETAILS=true

S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

NOTIFICACAO_ENABLED=true
NOTIFICACAO_BASE_URL=http://localhost:8086/api
# API Key: configure por organizacao no painel Super Admin (nao use .env)
NOTIFICACAO_REGISTRAR_CONSENTIMENTO=false
NOTIFICACAO_PUBLIC_BASE_URL=http://localhost:4200
NOTIFICACAO_PUBLIC_ORCAMENTO_PATH=/public/orcamento

