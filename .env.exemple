DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=

JWT_SECRET=change-me-use-at-least-32-characters-long
JWT_EXPIRATION_MINUTES=480

# false em producao para ocultar detalhes tecnicos nos erros 500
API_EXPOSE_ERROR_DETAILS=true

S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

NOTIFICACAO_ENABLED=false
NOTIFICACAO_BASE_URL=http://localhost:8080/api
# Recomendado: API Key M2M (scopes: NOTIFICACOES_ENVIAR, CONTATOS_GERENCIAR)
NOTIFICACAO_API_KEY=
NOTIFICACAO_LOGIN=
NOTIFICACAO_SENHA=
NOTIFICACAO_ID_ORGANIZACAO=
NOTIFICACAO_PUBLIC_BASE_URL=http://localhost:8080/orcafacil
NOTIFICACAO_TEMPLATE_ORCAMENTO=
# Timeout HTTP (ms) para chamadas a notificacao-api
NOTIFICACAO_CONNECT_TIMEOUT_MS=5000
NOTIFICACAO_READ_TIMEOUT_MS=30000
# Por tenant: colunas id_organizacao_notificacao e ds_api_key_notificacao em organizacao (DB central)
# NOTIFICACAO_ID_ORGANIZACAO e NOTIFICACAO_API_KEY sao fallback quando as colunas estiverem vazias

